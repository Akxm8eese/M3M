{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Body Zodiac public content v0.1",
  "type": "object",
  "required": [
    "version",
    "signs",
    "claims",
    "sources",
    "assets"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "signs": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "region",
          "element",
          "realm",
          "symbolicText",
          "foodIds",
          "claimIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "region": {
            "type": "string",
            "minLength": 1
          },
          "element": {
            "enum": [
              "fire",
              "earth",
              "air",
              "water"
            ]
          },
          "realm": {
            "enum": [
              "Land",
              "Sky",
              "Water",
              "Hybrid"
            ]
          },
          "symbolicText": {
            "type": "string"
          },
          "foodIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "claimIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "sourceIds",
          "reviewer",
          "reviewedAt",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "reviewedAt": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "const": "approved"
          }
        },
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "locator"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "license",
          "rightsEvidence",
          "approved"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "rightsEvidence": {
            "type": "string",
            "minLength": 1
          },
          "approved": {
            "const": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}
